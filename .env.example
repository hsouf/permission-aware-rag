# Copy to .env. Never commit real secrets.
PA_RAG_ENV=dev
# Signing key for the demo identity provider. In production you verify tokens
# from your real IdP (Okta, Entra ID, Google) with its published JWKS instead.
PA_RAG_JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes
# Postgres from docker-compose (only needed for the HR tool / integration tests).
PA_RAG_DATABASE_URL=postgresql://rag_gateway:rag_gateway_dev@localhost:5433/hr
# Optional answer step. "none" returns the authorized context instead of an answer.
# "claude" calls Claude; credentials come from ANTHROPIC_API_KEY or an `ant auth login` profile.
PA_RAG_LLM=none
